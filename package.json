{
  "name": "osc-midi-transmitter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bridge,vite -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --serve-static",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "osc-js": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
